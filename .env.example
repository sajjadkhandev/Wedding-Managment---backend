# WedPlan Backend Environment Configuration Template
# Duplicate this file to .env and adjust values for your environment.

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Local MongoDB or MongoDB Atlas URI)
# Example Local: mongodb://127.0.0.1:27017/wedplan_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/wedplan_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/wedplan_db

# Security & Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN_DAYS=7

# Default Currency & Region
DEFAULT_CURRENCY=PKR
DEFAULT_LOCALE=en-PK
